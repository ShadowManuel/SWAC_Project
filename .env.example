# Kopieren nach .env und die Werte ersetzen. Die .env wird nie committet.

# SQL Server verlangt mindestens 8 Zeichen mit Groß- und Kleinbuchstaben, Ziffer und Sonderzeichen.
AUTH_DB_PASSWORD=ChangeMe_Auth1!
TICKET_DB_PASSWORD=ChangeMe_Ticket1!

REDIS_PASSWORD=ChangeMe_Redis1!

# Admin-User, den der Auth-Service beim ersten Start anlegt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_Admin1!
